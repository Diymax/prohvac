# Скопируйте в .env.local для локальной разработки.
# На проде задайте эти значения в панели хостинга (Plesk → Node.js →
# Custom environment variables) — .env в репозиторий не коммитится.
#
# Пометка [ПРОД] означает: без переменной боевой запуск невозможен.
# assertProductionConfig() в server/config.js не даст процессу подняться —
# сервер, подписывающий сессии пустым секретом, хуже, чем упавший сервер.
# Локально те же переменные необязательны: подставляются дев-заглушки.

# --- Секреты приложения --------------------------------------------------
# Генерируются по одному разу и не переиспользуются между проектами:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"

# [ПРОД] Ключ подписи и шифрования: сессии, хеши IP, секреты в таблице
# settings. Минимум 32 символа. Смена значения разлогинивает всех
# и делает нечитаемыми ранее зашифрованные настройки.
APP_SECRET=

# [ПРОД] Отдельный ключ для гейта перед входом в админку. Обязан отличаться
# от APP_SECRET: с общим ключом токен гейта принимается как сессионный.
GATE_SECRET=

# [ПРОД] Секретный путь админки, без ведущего слэша: минимум 24 символа
# из строчных латинских букв, цифр и дефиса. Это единственное, что скрывает
# панель от сканеров, поэтому значение случайное, а не осмысленное:
#   node -e "console.log(require('node:crypto').randomBytes(16).toString('hex'))"
ADMIN_SECRET_PATH=

# --- Адреса и размещение -------------------------------------------------

# [ПРОД] Публичный адрес сайта: по нему строятся абсолютные ссылки
# и проверяется заголовок Origin. Только схема, домен и порт — без пути
# и завершающего слэша. Вне прода допустим http, в проде только https.
PUBLIC_ORIGIN=http://localhost:5173

# Каталог данных: файл SQLite и загруженные через админку файлы.
# Относительный путь разрешается от корня приложения, по умолчанию ./data.
# На Plesk стоит вынести его за пределы httpdocs, иначе база раздаётся по HTTP.
DATA_DIR=./data

# Порт HTTP-сервера. Под Passenger не используется: порт назначает он сам.
# PORT=3000

# --- Серверные (в клиентский бандл не попадают) --------------------------

# [ПРОД] Приём заявок: токен бота от @BotFather и id чата отдела продаж.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Необязательно: подменяет адрес Telegram Bot API. Нужен только для
# сквозного теста против локальной заглушки (см. scripts/mock-telegram.mjs),
# чтобы ничего не улетело в рабочий чат. В проде НЕ задавать — запуск
# с адресом на localhost будет отклонён.
# TELEGRAM_API_BASE=http://127.0.0.1:8788

# Необязательно: ключ DeepL для перевода контента из админки. Без него
# недоступен только автоперевод, остальное работает.
# DEEPL_API_KEY=

# Необязательно: список источников через запятую, если форма живёт
# на других доменах. PUBLIC_ORIGIN разрешается всегда; этот список только
# добавляет источники и не заменяет основной адрес сайта.
# ALLOWED_ORIGINS=https://www.prohvac.uz,https://landing.example

# Доверенные reverse proxy в CIDR-формате. ОБЯЗАТЕЛЬНА В ПРОДЕ: конфигурация
# без неё не стартует, и это осознанно.
#
# Пустой список означает «доверять только адресу сокета». За обратным прокси
# (Plesk, nginx, Passenger) сокет — это всегда сам прокси, поэтому
# X-Forwarded-For отбрасывается и адрес у ВСЕХ посетителей получается
# одинаковый. Дальше всё ломается тихо: лимит частоты заявок становится общим
# на весь сайт, а первый же сканер, дёрнувший honeypot-путь вроде /.env,
# блокирует этот общий хеш на сутки — и сайт начинает отвечать пустой
# оболочкой 404 вообще всем.
#
# Для Passenger за nginx на той же машине:
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
#
# Если процесс действительно смотрит в интернет напрямую, без прокси, — это
# надо заявить явно, иначе не отличить от «забыли»:
# TRUSTED_PROXY_CIDRS=none

# Необязательно: дополнительные имена хостов, за которые сервер отвечает,
# через запятую. Host (или :authority) каждого запроса обязан совпасть с этим
# списком, иначе ответ — 421 и дальше запрос не идёт. Так закрывается DNS
# rebinding: чужое имя, наведённое на наш адрес, браузер считал бы same-origin
# с нашими ответами.
#
# Хост из PUBLIC_ORIGIN разрешён всегда, перечислять его здесь не нужно.
# Запись без порта совпадает с любым портом, запись с портом — только с ним.
# Вне production дополнительно разрешены localhost, 127.0.0.1 и [::1].
#
# ВАЖНО: health check и любой мониторинг тоже проходят проверку. Если они
# ходят на сервер по IP или по внутреннему имени, это имя нужно добавить сюда,
# иначе они начнут получать 421:
# TRUSTED_HOSTS=127.0.0.1,prohvac.uz,internal-health.local

# --- Заголовки безопасности ----------------------------------------------

# Strict-Transport-Security. Заголовок ставится только в production.
#
# max-age в секундах, по умолчанию 31536000 (год).
# HSTS_MAX_AGE=31536000

# includeSubDomains распространяет запрет http на ВСЕ поддомены домена,
# включая чужие сервисы и внутренние стенды на нём. По умолчанию выключено:
# у побывавшего на сайте браузера отменить директиву до истечения max-age
# нельзя, поэтому включать её нужно, зная все поддомены.
# HSTS_INCLUDE_SUBDOMAINS=0

# preload вносит домен в список, зашитый в сборки браузеров; удаление оттуда
# занимает месяцы и от сервера уже не зависит. Требует
# HSTS_INCLUDE_SUBDOMAINS=1 и HSTS_MAX_AGE не меньше 31536000.
# HSTS_PRELOAD=0

# Яндекс.Метрика (счётчик задан в index.html и shared/analytics.js).
# По умолчанию выключено, и тогда доменов аналитики нет в Content-Security-Policy
# вовсе, а сниппет вырезается из оболочки. Включать вместе с обновлением
# уведомления о конфиденциальности.
#
# Счётчик получает ТОЛЬКО публичная страница: оболочка админки и любой 404
# идут через sendSpa() без аналитики. Иначе секретный путь админки уехал бы
# в отчёты Метрики, а Вебвизор записал бы панель с заявками и настройками.
#
# ВНИМАНИЕ ПРИ ПЕРВОЙ ВЫКЛАДКЕ: умолчание — ВЫКЛЮЧЕНО. Без ANALYTICS_ENABLED=1
# счётчика на сайте нет вовсе, и заметить это по интерфейсу нельзя — просто
# ноль визитов. Проверяется одной командой:
#   curl -sH 'Accept: text/html' https://www.prohvac.uz/ | grep -c mc.yandex.ru
# ANALYTICS_ENABLED=0

# OAuth-токен Яндекса для чтения статистики через Stat API (scope metrika:read).
# Нужен только дашборду «Аналитика» в админке; на сбор данных счётчиком
# не влияет. Это умолчание деплоя: значение можно перекрыть в админке
# (Настройки → analytics.metrica.oauth_token), потому что продлевать годовой
# токен должен уметь человек с админкой, а не только с панелью хостинга.
# Токен получать на ОТДЕЛЬНЫЙ технический аккаунт с гостевым доступом
# к счётчику: сервисных аккаунтов у Метрики нет, токен всегда привязан
# к человеку, и увольнение сотрудника не должно гасить дашборд.
# YANDEX_OAUTH_TOKEN=

# --- Сессии и квоты ------------------------------------------------------

# Простой до разлогинивания (минуты) и полный срок жизни сессии (часы).
# Первое обязано быть меньше второго, иначе абсолютный срок не наступит.
# SESSION_IDLE_MIN=30
# SESSION_ABSOLUTE_H=12

# Потолок для загруженных файлов, в байтах. По умолчанию 300 МБ.
# Тариф даёт 500 МБ сразу на всё — код, node_modules, базу и медиа, —
# поэтому больше ~450 МБ ставить бессмысленно: место кончится раньше квоты,
# и запись начнёт падать вместо честного «превышена квота».
# MEDIA_QUOTA_BYTES=314572800

# --- Режим админки -------------------------------------------------------

# Требовать прохождения гейта перед формой входа. По умолчанию включено
# в проде и выключено локально; явное значение сильнее умолчания.
# ADMIN_REQUIRE_GATE=1

# Предсказуемый путь /admin. По умолчанию выключен, и включать его не нужно:
# он сводит на нет весь смысл ADMIN_SECRET_PATH.
# ADMIN_LEGACY_PATH_ENABLED=0

# --- Клиентские (префикс VITE_ означает, что значение попадёт в публичный
#     бандл — сюда нельзя класть секреты) ---
# Адрес эндпоинта приёма заявок. По умолчанию /api/lead на том же домене.
VITE_LEAD_ENDPOINT=/api/lead
